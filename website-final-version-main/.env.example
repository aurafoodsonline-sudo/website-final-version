# Required production settings
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=aurafoods.example.com
DATABASE_URL=postgresql://aurafoods:replace-password@db:5432/aurafoods
CSRF_TRUSTED_ORIGINS=https://aurafoods.example.com
DJANGO_CORS_ORIGINS=https://aurafoods.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_ENABLE_BASIC_AUTH=0

# Staff MFA
STAFF_MFA_REQUIRED=1
MFA_SECRET_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# Production uploads: s3, r2, or s3-compatible
MEDIA_STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=aurafoods-media
AWS_ACCESS_KEY_ID=replace-in-secret-store
AWS_SECRET_ACCESS_KEY=replace-in-secret-store
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-in-secret-store
EMAIL_HOST_PASSWORD=replace-in-secret-store
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Aura Foods <no-reply@example.com>
